{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yomimasu",
  "main": "./site/worker.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/audio/*"]
  },
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "yomimasu-audio" }],
  "preview_urls": true,
  // プレビューは上の束縛を受け継がないので、同じバケットをもう一度書く。Worker はバケットを読むだけなので、プレビュー用のバケットに分けない。
  "previews": {
    "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "yomimasu-audio" }]
  }
}
